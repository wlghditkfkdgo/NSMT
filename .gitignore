# Checkpoints, serialized arrays, and transfer archives
*.pt
*.pth
*.ckpt
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.hdf5
*.zip
*.tar
*.tar.gz
*.tgz

# Raw runtime output; text metric tables remain versioned
*.stdout
*.log
*.out
events.out.tfevents.*
*.lock
**/scripts/queues/*.txt
**/log/**/*.png
**/log/**/*.pdf

# Credentials and local environment files
.env
.env.*
!.env.example
*.pem
*.key
