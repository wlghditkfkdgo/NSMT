# Local caches and editor state
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.vscode/
.DS_Store

# Local datasets (restore separately; see docs/PROJECT_LOG.md)
**/dataset/**
!**/dataset/**/
!**/dataset/**/*.py
!**/dataset/**/*.sh
dataset_pt/
!NSMT/model_v1/forecasting/dataset
!NSMT/neorecall_v1/forecasting/dataset
